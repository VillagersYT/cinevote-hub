{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "buildCommand": "VITE_SUPABASE_URL=\"$SUPABASE_URL\" VITE_SUPABASE_PUBLISHABLE_KEY=\"$SUPABASE_ANON_KEY\" VITE_SUPABASE_PROJECT_ID=\"$SUPABASE_PROJECT_ID\" SUPABASE_PUBLISHABLE_KEY=\"$SUPABASE_ANON_KEY\" npm run build"
}
