{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "buildCommand": "SUPABASE_URL=\"${SUPABASE_URL:-$NEXT_PUBLIC_SUPABASE_URL}\" SUPABASE_PUBLISHABLE_KEY=\"${SUPABASE_PUBLISHABLE_KEY:-${SUPABASE_ANON_KEY:-$NEXT_PUBLIC_SUPABASE_ANON_KEY}}\" VITE_SUPABASE_URL=\"${SUPABASE_URL:-$NEXT_PUBLIC_SUPABASE_URL}\" VITE_SUPABASE_PUBLISHABLE_KEY=\"${SUPABASE_PUBLISHABLE_KEY:-${SUPABASE_ANON_KEY:-$NEXT_PUBLIC_SUPABASE_ANON_KEY}}\" VITE_SUPABASE_PROJECT_ID=\"${SUPABASE_PROJECT_ID:-$NEXT_PUBLIC_SUPABASE_PROJECT_ID}\" npm run build"
}
